[Unit]
Description=DoH path-forward proxy (Go, cloudflare-doh)
Documentation=https://github.com/JackCh3n/cloudflare-doh
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# 配了证书时 -listen 直接变 HTTPS（EdgeOne 走 HTTPS 回源）；
# 想同时保留 HTTP，再加 -tls-listen :8444 变成双监听。
ExecStart=/opt/doh-proxy/doh-proxy -listen :8080 -tls-cert /opt/doh-proxy/tls/dohj.crt -tls-key /opt/doh-proxy/tls/dohj.key

# 上游与路径映射沿用 Worker 版默认值，需要改映射就设 DOMAIN_MAPPINGS（JSON 字符串）
Environment=LISTEN_ADDR=:8080
Environment=DEFAULT_UPSTREAM=cloudflare
Environment=CACHE_TTL=30
Environment=HEALTH_PATH=/healthz
Environment=TLS_CERT=/opt/doh-proxy/tls/dohj.crt
Environment=TLS_KEY=/opt/doh-proxy/tls/dohj.key
# 只允许 EdgeOne 加速域名与源站 IP 访问（伪造 Host 会拿到伪装 404）
Environment=ALLOWED_HOSTS=dohj.example.com,203.0.113.10

# 并发与资源护栏（默认即生效，无需再改）
Environment=MAX_INFLIGHT=512        # 全局在途请求上限，满则 503 + Retry-After
Environment=MAX_CONNS_PER_HOST=64   # 单上游连接上限，形成背压
Environment=MEM_LIMIT_MB=512        # 软内存上限，先 GC 降速而不是 OOM
Environment=METRICS_PATH=/metrics   # 运行指标（在途数/累计请求/上游错误）
# 需要全局限速时再打开：Environment=MAX_RPS=200

Restart=always
RestartSec=2
LimitNOFILE=65535
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
